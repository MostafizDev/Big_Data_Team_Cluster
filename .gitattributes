# Normalize text files to LF in the repository.
*            text=auto

# Executed inside Linux containers or by bash: must stay LF on every checkout (incl. Windows).
*.sh         text eol=lf
Dockerfile   text eol=lf
*.yml        text eol=lf
*.conf       text eol=lf
*.xml        text eol=lf
*.py         text eol=lf
.env.example text eol=lf

# Windows-native scripts
*.ps1        text eol=crlf
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binary
*.parquet    binary
*.png        binary
