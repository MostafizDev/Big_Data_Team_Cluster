# =============================================================================
# TeamSpark environment - copy to .env and adjust.
#
# Default sizing targets Docker Desktop with ~8 GB RAM / 12 CPUs.
# Memory budget (container limits):
#   master 1g + history 0.75g + connect 2g + 2 x worker 2.5g = 8.75g (caps,
#   not reservations; typical idle use is ~2.5g). For heavier team use, raise
#   Docker Desktop -> Settings -> Resources -> Memory to 12 GB and use the
#   "12 GB profile" values noted below.
#
# Team sizing: tested with 4 concurrent members. All members share one Spark
# Connect application; the FAIR scheduler gives each active member an equal
# share of SPARK_CORES_MAX (8 cores -> ~2 each when all 4 are busy).
# Per-session limits (result size, idle timeout) are in conf/spark-defaults.conf.
#
# This file is a template: copy it to .env (git-ignored) and put real values
# such as your Tailscale IP only in .env, never here.
# =============================================================================

TEAMSPARK_VERSION=4.1.4-py3.12-java21

# ---- Network exposure ---------------------------------------------------------
# Spark Connect is the ONLY service intended for remote users.
#   127.0.0.1      -> local testing on this Mac only (default, safest)
#   100.x.y.z      -> this Mac's Tailscale IPv4 (`tailscale ip -4`): reachable
#                     only by tailnet devices allowed by your Tailscale ACLs
# Never use 0.0.0.0 here: Spark Connect has no authentication in this setup.
CONNECT_BIND_IP=127.0.0.1
CONNECT_PORT=15002

# Admin UIs - always bound to 127.0.0.1 in docker-compose.yml
MASTER_UI_PORT=8080
CONNECT_UI_PORT=4040
HISTORY_UI_PORT=18080

# ---- Storage --------------------------------------------------------------------
# Host directory for user-visible data (warehouse, datasets, event logs).
TEAMSPARK_STORAGE_DIR=./storage

# ---- Workers (per worker) -------------------------------------------------------
SPARK_WORKER_CORES=4          # 12 GB profile: 4
SPARK_WORKER_MEMORY=1536m     # 12 GB profile: 3g   (memory offered to executors)
SPARK_DAEMON_MEMORY=256m      # heap of master/worker/history daemons
WORKER_CPU_LIMIT=4.0
WORKER_MEM_LIMIT=2560m        # 12 GB profile: 4g   (executor + overhead + python)

# ---- Executors ------------------------------------------------------------------
# One executor per worker: cores == SPARK_WORKER_CORES, memory <= SPARK_WORKER_MEMORY
SPARK_EXECUTOR_CORES=4
SPARK_EXECUTOR_MEMORY=1536m   # 12 GB profile: 3g
SPARK_CORES_MAX=8             # total cores for the shared Connect app (= sum of workers)

# ---- Spark Connect server (driver) ----------------------------------------------
CONNECT_DRIVER_MEMORY=1g      # 12 GB profile: 2g
CONNECT_CPU_LIMIT=2.0
CONNECT_MEM_LIMIT=2g          # 12 GB profile: 3g
